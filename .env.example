# ---------------------------------------------------------------------------
# Lead -> Launch environment
# Copy to .env and fill in what you actually have. Every integration degrades
# to a clearly-labelled mock when its key is absent - the app is fully usable
# with nothing but DATABASE_URL set.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production): set the URL below and change `provider` to
# "postgresql" in prisma/schema.prisma, then run `npm run db:migrate`.
# DATABASE_URL="postgresql://user:password@localhost:5432/leadlaunch?schema=public"

# --- Runtime mode ----------------------------------------------------------
# demo  = every external provider is mocked and labelled as such in the UI
# live  = real providers are used wherever a key is present, mocks elsewhere
APP_MODE="demo"

# Default single-tenant workspace slug used until real auth is wired up.
DEFAULT_WORKSPACE_SLUG="studio"

# --- AI provider keys ------------------------------------------------------
# Any subset may be set. Capability -> provider routing lives in the
# AI Control Center and is stored per workspace in the database.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- Business data provider keys ------------------------------------------
# Used by the discovery engine. Without one, MockBusinessDataProvider is used.
GOOGLE_PLACES_API_KEY=""
SERPAPI_API_KEY=""

# --- Audit engine ----------------------------------------------------------
# The built-in fetch-heuristic auditor needs no key. Set this to opt in to a
# hosted Lighthouse run (Google PageSpeed Insights API).
PAGESPEED_API_KEY=""
# Hard ceiling on how long a single page fetch may take, in milliseconds.
AUDIT_FETCH_TIMEOUT_MS="15000"

# --- Deployment providers --------------------------------------------------
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
NETLIFY_TOKEN=""

# --- Outreach providers ----------------------------------------------------
# Sending is disabled unless a provider is configured AND the message has been
# manually approved in the UI.
RESEND_API_KEY=""
OUTREACH_FROM_EMAIL=""
# Maximum approved messages that may be dispatched per hour, per workspace.
OUTREACH_RATE_LIMIT_PER_HOUR="20"

# --- Website Studio --------------------------------------------------------
# Root directory for generated website projects. Each prospect gets an
# isolated subdirectory. Must be outside the app source tree in production.
PROJECTS_ROOT="./projects"
# Upper bound on visual-QA fix iterations per build.
WEBSITE_MAX_QA_ITERATIONS="3"
