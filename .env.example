# ---------------------------------------------------------------------------
# Lead -> Launch environment
#
# Copy to .env and fill in what you actually have. Every integration degrades to
# a clearly-labelled mock when its credential is absent - the app is fully
# usable with nothing but DATABASE_URL set.
#
# SECURITY
#   Only NEXT_PUBLIC_* values reach the browser. Everything else is read
#   server-side in src/config/app.ts and must never be given that prefix.
#   Never commit a filled-in .env.
# ---------------------------------------------------------------------------


# ===========================================================================
# PUBLIC  (bundled into the browser - must contain no secrets)
# ===========================================================================

# Supabase project URL and anon key. Both are designed to be public; access is
# governed by row-level security, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""


# ===========================================================================
# SERVER ONLY  (never exposed to the browser)
# ===========================================================================

# --- Core -------------------------------------------------------------------
# demo = every external provider is mocked and labelled as such in the UI
# live = real providers are used wherever a credential is present
APP_MODE="demo"
APP_URL="http://localhost:3000"

# Single-tenant workspace slug used until real auth is switched on.
DEFAULT_WORKSPACE_SLUG="studio"

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL / Supabase (production): set the URL below, change `provider` to
# "postgresql" in prisma/schema.prisma, install @prisma/adapter-pg and register
# it in src/db/client.ts, then run `npm run db:migrate`.
# DATABASE_URL="postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres"

# --- Authentication ---------------------------------------------------------
# Server-side Supabase key. Bypasses row-level security - treat as a root
# credential and never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Set to true once the Google provider is enabled in the Supabase dashboard.
AUTH_GOOGLE_ENABLED="false"

# --- AI providers -----------------------------------------------------------
# Any subset may be set. Capability -> provider routing lives in the AI Control
# Center and is stored per workspace in the database.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- Business discovery -----------------------------------------------------
# Without one of these, MockBusinessDataProvider is used and every record is
# labelled as demo data.
GOOGLE_PLACES_API_KEY=""
SERPAPI_API_KEY=""

# --- Website audit ----------------------------------------------------------
# The built-in fetch auditor needs no key. Set this to add real Lighthouse
# scores including Core Web Vitals (Google PageSpeed Insights API).
PAGESPEED_API_KEY=""
# Hard ceiling on a single page fetch, in milliseconds.
AUDIT_FETCH_TIMEOUT_MS="15000"

# --- Email ------------------------------------------------------------------
# Sending is disabled unless a provider is configured AND the message has been
# manually approved in the UI.
RESEND_API_KEY=""
OUTREACH_FROM_EMAIL=""
# Maximum approved messages dispatched per hour, per workspace.
OUTREACH_RATE_LIMIT_PER_HOUR="20"

# --- Meta: WhatsApp Business (Cloud API) ------------------------------------
# This is not a simple API key. You need a Meta app, a WhatsApp Business
# Account, a registered phone number, and a system-user access token.
# The App ID / Business Account ID / Phone Number ID are configuration and are
# entered in Settings -> WhatsApp; only the secrets belong here.
#   https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=""
# Any random string. Meta echoes it back when you register the webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# From the Meta app's Basic Settings. Used to verify X-Hub-Signature-256 on
# inbound webhooks - without it, webhook payloads cannot be trusted.
META_APP_SECRET=""
META_API_VERSION="v21.0"

# --- Meta: Instagram messaging ----------------------------------------------
# Replies only. Instagram provides no sanctioned way to cold-DM someone who has
# not messaged you first, and this app does not work around that.
#   https://developers.facebook.com/docs/messenger-platform/instagram
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""

# --- Deployment -------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
NETLIFY_TOKEN=""

# --- Generated website source control ---------------------------------------
# A serverless filesystem is not durable. Set these to push each generated site
# to its own repository instead of relying on local disk.
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO_PREFIX="site-"

# --- Object storage ---------------------------------------------------------
# none | supabase
STORAGE_PROVIDER="none"
STORAGE_BUCKET="websites"

# --- Website Studio ---------------------------------------------------------
# Root directory for generated projects. Each prospect gets an isolated
# subdirectory. Treated as a build cache, not the source of truth.
PROJECTS_ROOT="./projects"
# Upper bound on visual-QA fix iterations per build.
WEBSITE_MAX_QA_ITERATIONS="3"


# --- Credential encryption ---------------------------------------------------
# Seals OAuth tokens at rest with AES-256-GCM. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without this the app REFUSES to store a Google refresh token at all, rather
# than falling back to plaintext. That refusal is deliberate: a silent
# downgrade is worse than a visible failure.
TOKEN_ENCRYPTION_KEY=""


# --- Gmail (Google OAuth 2.0) ------------------------------------------------
# Create an OAuth client of type "Web application" in Google Cloud, enable the
# Gmail API on the same project, and add the redirect URI below to the client's
# authorised redirect URIs *exactly* as written.
#
# The app requests one scope: https://www.googleapis.com/auth/gmail.compose
# (create, update and send drafts). It does NOT request gmail.readonly,
# gmail.modify or mail.google.com - reading a mailbox is a different order of
# access and this product does not need it.
#
# There is no Gmail password field anywhere in this application, and there
# never will be.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"


# --- Research budget ---------------------------------------------------------
# Research is the recurring cost in this product. Every limit here is enforced
# by the crawler, not merely suggested.

# Hard ceiling on pages fetched per site, whatever the navigation contains.
RESEARCH_MAX_PAGES="6"
# Response bodies are read in chunks and abandoned past this, so a
# Content-Length that lies cannot exhaust memory.
RESEARCH_MAX_BYTES="1500000"
RESEARCH_TIMEOUT_MS="12000"
# Each redirect hop is re-validated against the SSRF guard.
RESEARCH_MAX_REDIRECTS="3"
# Minimum gap between two requests to the same host.
RESEARCH_HOST_THROTTLE_MS="1200"
RESEARCH_CACHE_TTL_DAYS="30"
# Honour robots.txt on business sites. Turn off only for local testing.
RESEARCH_RESPECT_ROBOTS="true"
# Identifies this crawler to the sites it visits. Put a real contact URL here.
RESEARCH_USER_AGENT=""

# Overpass endpoint for the free OpenStreetMap discovery layer. No key needed.
# Overpass is volunteer-run: the app throttles and sends one query per campaign.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Google Places calls included in your monthly free allowance, so the Settings
# page can report how much of it is left. Check your current Google billing
# terms - this is a display figure, not something Google is told about.
GOOGLE_PLACES_FREE_CALLS="5000"
